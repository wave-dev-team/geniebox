{
  "name": "@workspace/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copy-locales.mjs",
    "dev": "pnpm build && concurrently --kill-others \"tsc -p tsconfig.build.json --watch\" \"node --watch dist/main.js\"",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathIgnorePatterns=integration",
    "test:integration": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --testPathPatterns=integration",
    "db:bootstrap": "node dist/database/cli.js bootstrap",
    "db:migrate": "node dist/database/cli.js migrate",
    "db:rollback": "node dist/database/cli.js rollback",
    "db:status": "node dist/database/cli.js status",
    "db:types": "kysely-codegen --url 'env(DB_MIGRATION_URL)' --exclude-pattern='public.kysely_*' --out-file src/database/types.ts"
  },
  "dependencies": {
    "@nestjs/common": "11.2.12",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.12",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.12",
    "@nestjs/swagger": "11.4.8",
    "@nestjs/terminus": "11.1.1",
    "@nestjs/throttler": "6.8.0",
    "@workspace/types": "workspace:*",
    "argon2": "0.45.2",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "helmet": "8.3.0",
    "ioredis": "5.11.1",
    "kysely": "0.29.9",
    "nestjs-cls": "7.0.2",
    "nestjs-i18n": "10.8.5",
    "nestjs-pino": "5.3.2",
    "nodemailer": "10.6.1",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.23.1",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@jest/globals": "30.5.2",
    "@nestjs/testing": "11.2.12",
    "@testcontainers/postgresql": "12.2.2",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "22.19.11",
    "@types/nodemailer": "8.0.2",
    "@types/passport-jwt": "4.0.2",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "@workspace/tsconfig": "workspace:*",
    "concurrently": "9.2.5",
    "jest": "30.5.2",
    "kysely-codegen": "0.20.0",
    "supertest": "7.3.2",
    "testcontainers": "12.2.2",
    "ts-jest": "29.4.15",
    "typescript": "5.9.3"
  },
  "files": [
    "dist"
  ]
}
