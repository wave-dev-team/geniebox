app.geniebox.ru {
	import common

	@browser_api path /api/v1 /api/v1/*
	handle @browser_api {
		reverse_proxy 127.0.0.1:3000
	}
	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		reverse_proxy 127.0.0.1:3000
	}
}

api.geniebox.ru {
	import common

	handle_path /api/* {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}
}
