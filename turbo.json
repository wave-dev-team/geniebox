{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "API_HOST",
        "API_PORT",
        "DATABASE_URL",
        "JWT_SECRET",
        "NODE_ENV",
        "AUTH_IDENTITY_SECRET",
        "REDIS_URL",
        "SMTP_URL",
        "AUTH_MAIL_FROM",
        "AUTH_COOKIE_SECURE",
        "TRUST_PROXY_HOPS"
      ]
    }
  }
}
