NODE_ENV=development
LOG_LEVEL=debug

PUBLIC_HOST=0.0.0.0
PUBLIC_PORT=3000
INTERNAL_HOST=127.0.0.1
INTERNAL_PORT=3100

CORS_ORIGINS=http://localhost:3001,http://localhost:3002
# SWAGGER_ENABLED=true

# Role names are fixed: geniebox_owner / geniebox_app / geniebox_system.
DATABASE_URL=postgres://geniebox_app:app_dev_password@localhost:5432/geniebox
DATABASE_SYSTEM_URL=postgres://geniebox_system:system_dev_password@localhost:5432/geniebox
DATABASE_POOL_MAX=10
# DB tooling only (db:bootstrap / db:migrate), never set for the running app.
DATABASE_OWNER_URL=postgres://geniebox_owner:owner_dev_password@localhost:5432/geniebox
DATABASE_ADMIN_URL=postgres://postgres:postgres@localhost:5432/postgres

APP_PUBLIC_URL=http://localhost:3001

# >= 32 chars. Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=dev-only-secret-change-me-0123456789abcdef
# ACCESS_TOKEN_TTL_SEC=900
# REFRESH_TOKEN_TTL_DAYS=30
# REFRESH_TOKEN_MAX_AGE_DAYS=90
AUTH_GOOGLE_CLIENT_IDS=
AUTH_APPLE_CLIENT_IDS=

# log (dev, prints mails) | memory (tests) | smtp (required in production)
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://localhost:1025
MAIL_FROM="Geniebox <no-reply@geniebox.local>"
SUPPORT_EMAIL=support@geniebox.local

# Connection secrets: RSA key pair. The private key is for the worker only.
SECRETS_PUBLIC_KEY_FILE=.secrets/kek.pub.pem
SECRETS_PRIVATE_KEY_FILES=.secrets/kek.key.pem
CONNECTIONS_ALLOW_PRIVATE_HOSTS=true

REDIS_STATE_URL=redis://localhost:6379/0
REDIS_CACHE_URL=redis://localhost:6380/0

# Agent runtime. fake = deterministic offline provider for dev and tests.
LLM_PROVIDER=fake
# OPENAI_API_KEY=sk-...
# LLM_MODEL=gpt-4.1-mini

# Knowledge base: uploaded sources, outside the web root and shared with the worker.
KNOWLEDGE_BLOB_DIR=./data/knowledge
# KNOWLEDGE_MAX_UPLOAD_BYTES=20971520
# none (FTS only) | fake (offline, tests) | openai
EMBEDDING_PROVIDER=none
# EMBEDDING_MODEL=text-embedding-3-small
# EMBEDDING_DIMENSIONS=1536
# EMBEDDING_API_KEY=sk-... (defaults to OPENAI_API_KEY)
# EMBEDDING_PRICE_PER_MTOK=0.02
